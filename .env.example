# 복사해서 .env 로 저장하세요: cp .env.example .env
# gemini(기본) 또는 ollama(내 맥에서 직접 생성, 키 불필요)
LLM_PROVIDER=gemini
# OLLAMA_MODEL=exaone3.5:7.8b

GEMINI_API_KEY=...            # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.6-flash

# local(bge-m3, 무료) 또는 openai
EMBEDDING_PROVIDER=local
# OPENAI_API_KEY=sk-...

CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
